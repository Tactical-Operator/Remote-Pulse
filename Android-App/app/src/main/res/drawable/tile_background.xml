<?xml version="1.0" encoding="utf-8"?>

<!--
    Background drawable applied to individual Remote Pulse tiles.

    Defines a rectangular shape with:
    - Black fill.
    - Thin grey border.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Black background of each tile -->
    <solid android:color="#000000" />

    <!-- Thin grey outline separating adjacent tiles -->
    <stroke
        android:width="1dp"
        android:color="#B0B0B0" />

</shape>